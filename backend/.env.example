# ===== 应用配置 =====
APP_NAME=食遇校园 - AI智能食堂推荐
DEBUG=True

# ===== 数据库配置 =====
# 本地开发用 SQLite，生产环境可换 MongoDB 云数据库
# 例如: mongodb+aiomongo://user:pass@host:27017/shiyu
DATABASE_URL=sqlite+aiosqlite:///./shiyu.db

# ===== JWT 配置 =====
SECRET_KEY=请替换为随机字符串-生产环境务必修改
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 微信小程序配置 =====
WECHAT_APPID=你的微信小程序appid
WECHAT_SECRET=你的微信小程序secret

# ===== 大模型 AI 配置 =====
# 支持: qwen / deepseek / kimi / zhipu
# 推荐用通义千问（有免费额度）：https://bailian.console.aliyun.com
AI_PROVIDER=qwen
AI_API_KEY=你的通义千问API密钥
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-turbo

# ===== 管理后台账号 =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
